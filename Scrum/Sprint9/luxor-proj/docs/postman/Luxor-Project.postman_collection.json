                "description": "Crea un usuario nuevo con rol CLIENTE por defecto.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Diego Test\",\n  \"email\": \"diego.test@luxor.com\",\n  \"password\": \"test123\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "auth": {
                  "type": "noauth"
                }
              }
            },
            {
              "name": "Login (guarda token)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/login",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "login"
                  ]
                },
                "description": "Login. El test script guarda automáticamente {{token}} y {{user_id}} para las demás requests.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@luxor.com\",\n  \"password\": \"123456\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "auth": {
                  "type": "noauth"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    const data = pm.response.json();",
                      "    if (data.token) {",
                      "        pm.collectionVariables.set('token', data.token);",
                      "    }",
                      "    if (data.user && data.user.id) {",
                      "        pm.collectionVariables.set('user_id', data.user.id);",
                      "    }",
                      "}",
                      "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                    ]
                  }
                }
              ]
            }
          ],
          "description": "Registro y login. El login corre un script que guarda el token JWT en la variable de colección {{token}}."
        },
