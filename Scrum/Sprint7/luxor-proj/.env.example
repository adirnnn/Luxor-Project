# ejemplo de variables de entorno para el frontend (vite).
# copiar este archivo como .env.local para desarrollo, o cargarlo en el
# panel de vercel para produccion. el .env real esta en .gitignore.

# vite solo le pasa al browser las variables que empiezan con VITE_.
# si esta variable no se define, el codigo cae al valor por defecto
# http://localhost:3000 (ver src/services/apiClient.ts).

# url del backend en produccion, sin la barra final.
VITE_API_URL=https://reemplazar-por-la-url-del-backend
