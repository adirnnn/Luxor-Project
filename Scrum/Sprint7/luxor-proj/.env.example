# ejemplo de variables de entorno del proyecto.
#
# copiar este archivo como .env (en esta misma carpeta) y completar los
# valores. el .env real esta en .gitignore y NO se sube al repo.
#
# docker-compose.yml usa este .env para tres servicios a la vez: backend
# (node), db (postgres) y chatbot (fastapi). el frontend (vite) tambien lee
# las variables VITE_ de este archivo en el build local.
#
# en produccion cada variable se carga en el panel del proveedor:
#   - frontend  -> Vercel  (solo las VITE_)
#   - backend / chatbot / db -> Render (el resto)


# ----------------------------------------------------------------------------
# frontend (vite)
# ----------------------------------------------------------------------------
# vite solo expone al browser las variables que empiezan con VITE_ y las
# resuelve en tiempo de build: si se cambian en vercel hay que volver a
# desplegar para que tomen efecto. sin la barra final.

# url publica del backend node (express). si no se define, el codigo cae a
# http://localhost:3000 (ver src/services/apiClient.ts).
VITE_API_URL=https://reemplazar-por-la-url-del-backend

# url publica del microservicio del chatbot (fastapi). si no se define, el
# codigo cae a http://127.0.0.1:8000 (ver src/services/chatbotService.ts).
VITE_CHATBOT_URL=https://reemplazar-por-la-url-del-chatbot


# ----------------------------------------------------------------------------
# base de datos (postgres)
# ----------------------------------------------------------------------------
# en local los usa docker-compose para levantar el contenedor de postgres y
# para que el backend se conecte. en Render estos valores salen del servicio
# de postgres administrado (bloque databases: de render.yaml).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=habibi_parfums
POSTGRES_HOST=db
POSTGRES_PORT=5432


# ----------------------------------------------------------------------------
# backend node (express)
# ----------------------------------------------------------------------------
# secreto para firmar los JWT. generar uno largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# en Render se deja que lo genere el panel (generateValue en render.yaml).
JWT_SECRET=cambiar-por-un-valor-aleatorio-largo

# origen del frontend, para el CORS del backend. en local el de vite.
FRONTEND_URL=http://localhost:5173

# api externa de datos de perfumes (fija).
PERFUM_API_BASE_URL=https://perfumapidatabase.onrender.com

# clave del simulador de pagos (fija para el entorno de pruebas).
PAYMENT_GATEWAY_API_KEY=sandbox_dev_key


# ----------------------------------------------------------------------------
# chatbot (fastapi)
# ----------------------------------------------------------------------------
# proveedor de LLM (ver backend/chatbot/app/llm/factory.py):
#   - ollama            -> modelo local via ollama (por defecto, desarrollo).
#   - groq / openai     -> api externa compatible con openai (produccion).
LLM_PROVIDER=ollama

# --- opcion A: proveedor compatible con openai (groq) --------------------
# solo hace falta si LLM_PROVIDER=groq (o openai).
# url base de la api, sin la barra final. groq -> https://api.groq.com/openai/v1
LLM_API_BASE_URL=https://api.groq.com/openai/v1

# clave de groq. crearla en https://console.groq.com/keys y pegarla aca
# (este .env NO se sube al repo). EN PRODUCCION NO VA AQUI: se carga a mano
# en Render, en el servicio luxor-chatbot -> Environment -> LLM_API_KEY
# (esta marcada como sync:false en render.yaml, no viaja por git).
LLM_API_KEY=

# id del modelo. verificar el id exacto en la consola de groq.
LLM_MODEL=llama-3.1-8b-instant

# --- opcion B: ollama local --------------------------------------------------
# solo se usan si LLM_PROVIDER=ollama.
# docker-compose ya setea OLLAMA_URL a http://host.docker.internal:11434.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# url del backend node que consume el chatbot. en docker-compose se
# sobreescribe a http://backend:3000; en Render apunta a la url publica
# del backend.
NODE_API_URL=http://127.0.0.1:3000

# origenes permitidos para el CORS del chatbot, separados por coma.
CHATBOT_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
